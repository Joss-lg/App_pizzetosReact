# AWS / DynamoDB
AWS_REGION=us-east-1

# Para pruebas locales con DynamoDB Local (Docker).
# Comentar esta línea para usar DynamoDB real en AWS.
DYNAMODB_ENDPOINT=http://localhost:8000

# Nombre de la tabla
ORDERS_TABLE=PizzetosOrders

# Firebase Admin SDK
# Ruta relativa al archivo de service account (se excluye del repositorio).
# Descárgalo desde Firebase Console → Configuración del proyecto → Cuentas de servicio.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
